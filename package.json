{
  "name": "sgmap-use",
  "version": "0.2.0",
  "description": "Vue 3 composables for 思极地图 (SGMap)",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "composables",
    "sgmap",
    "思极地图",
    "mapbox",
    "gis",
    "map"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./imports": {
      "types": "./dist/imports.d.ts",
      "import": "./dist/imports.mjs"
    },
    "./resolvers": {
      "types": "./dist/resolvers.d.ts",
      "import": "./dist/resolvers.mjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^27.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-dts": "^4.5.0",
    "vitest": "^3.2.0",
    "vue": "^3.5.0",
    "vue-tsc": "^3.0.0"
  }
}
